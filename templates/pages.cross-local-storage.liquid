{% layout none %}

{% comment %}
Endpoint para salvar/ler cookies via fetch
Aceita parâmetros via query string:
- method: 'get' ou 'set'
- key: chave do cookie
- value: valor (apenas para 'set')
{% endcomment %}

{%- assign method = request.params.method | default: '' -%}
{%- assign key = request.params.key | default: '' -%}
{%- assign value = request.params.value | default: '' -%}

<script>
  (function () {
    var method = "{{ method }}";
    var key = "{{ key }}";
    var value = "{{ value }}";
    var result = null;
    var error = null;

    try {
      switch (method) {
        case 'get': {
          // Lê cookie
          var nameEQ = key + '=';
          var cookies = document.cookie.split(';');
          for (var i = 0; i < cookies.length; i++) {
            var cookie = cookies[i].trim();
            if (cookie.indexOf(nameEQ) === 0) {
              result = cookie.substring(nameEQ.length, cookie.length);
              break;
            }
          }
          break;
        }
        case 'set': {
          // Salva cookie com domínio compartilhado para .myshopify.com
          var cookieString = key + '=' + value + '; Path=/; Max-Age=31536000; SameSite=Lax';
          // Se for subdomínio do myshopify.com, usa domínio compartilhado
          if (window.location.hostname.includes('.myshopify.com')) {
            cookieString += '; Domain=.myshopify.com';
          }
          document.cookie = cookieString;
          result = 'ok';
          break;
        }
        default:
          error = 'Método inválido: ' + method;
      }
    } catch (e) {
      error = e.message;
    }

    var response = {
      success: error === null,
      data: result,
      error: error
    };

    // Retorna JSON diretamente
    document.open();
    document.write(JSON.stringify(response));
    document.close();
  })();
</script>